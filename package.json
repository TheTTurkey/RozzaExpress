{
  "name": "rozza-express-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @rozza-express/shared",
    "build:all": "npm run build:shared && npm run build --workspaces --if-present",
    "dev:user": "npm run dev -w @rozza-express/user-app",
    "dev:staff": "npm run dev -w @rozza-express/staff-app",
    "dev:server": "npm run dev -w @rozza-express/server"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
